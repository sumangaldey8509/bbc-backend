PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/bengal_business_council

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM="BBC - Bengal Business Council <noreply@bengalbusinesscouncil.com>"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Cloudinary (profile media & document uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Base folder. Each member's files land in <CLOUDINARY_FOLDER>/users/<firstname_lastname>
CLOUDINARY_FOLDER=bbc

# Supabase Realtime (private messaging channels)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key
SUPABASE_JWT_SECRET=your_project_jwt_secret

# Optional: enable Enhanced Push Security in EAS and put its server access token here.
EXPO_PUSH_ACCESS_TOKEN=
